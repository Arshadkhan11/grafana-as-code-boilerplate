{
  "uid": "{{dashboard.uid}}",
  "title": "{{dashboard.title}}",
  "schemaVersion": 39,
  "tags": ["grafana-as-code", "{{microservice.cluster}}"],
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request rate",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "{{datasources.prometheus_uid}}"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{service=\"{{microservice.service_name}}\"}[5m]))"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Error rate",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0},
      "datasource": {"type": "prometheus", "uid": "{{datasources.prometheus_uid}}"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{service=\"{{microservice.service_name}}\",code=~\"5..\"}[5m]))"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "p99 latency",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0},
      "datasource": {"type": "prometheus", "uid": "{{datasources.prometheus_uid}}"},
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{service=\"{{microservice.service_name}}\"}[5m])) by (le))"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Pod CPU saturation",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "{{datasources.prometheus_uid}}"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(container_cpu_usage_seconds_total{pod=~\"{{microservice.service_name}}.*\"}[5m]))"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Kafka consumer lag",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "datasource": {"type": "prometheus", "uid": "{{datasources.prometheus_uid}}"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kafka_consumergroup_lag{consumergroup=\"{{monitoring.consumer.group}}\"})"
        }
      ]
    }
  ]
}
